Options -Indexes
DirectoryIndex public/index.php

<IfModule mod_rewrite.c>
    RewriteEngine On

    RewriteRule ^(app|bootstrap|config|database|docs|routes|storage|tests|vendor)(/|$) - [F,L,NC]
    RewriteRule ^(\.env|composer\.(json|lock)|.*\.sql|.*\.log)$ - [F,L,NC]
    RewriteRule ^(index\.html|dashboard\.html|css|js)(/|$) - [F,L,NC]

    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ public/index.php [QSA,L]
</IfModule>
