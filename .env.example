APP_ENV=local
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_BASE_PATH=
APP_TIMEZONE=Asia/Ho_Chi_Minh
SESSION_NAME=paper_page_session
SESSION_TIMEOUT=1800
ALLOW_PUBLIC_REGISTRATION=true
DAILY_FINE=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=paper_page_library
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

# Thay bằng mật khẩu mạnh trước khi chạy database/seed.php.
SEED_ADMIN_EMAIL=admin@paperpage.local
SEED_ADMIN_PASSWORD=

# Chỉ bật fixture tổng hợp trên môi trường local; mật khẩu trống sẽ được tạo và lưu vào .env.
SEED_DEMO_DATA=false
SEED_DEMO_LIBRARIAN_EMAIL=demo-librarian@paperpage.local
SEED_DEMO_LIBRARIAN_PASSWORD=
SEED_DEMO_READER_EMAIL=demo-reader@paperpage.local
SEED_DEMO_READER_PASSWORD=

# Optional: OFF by default. Never commit real API keys.
CHAT_LLM_ENABLED=false
OPENAI_API_KEY=
CHAT_LLM_MODEL=
